package in.tms.springbootcrud.springbootcrudapi.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import in.tms.springbootcrud.springbootcrudapi.model.Ticket;
import in.tms.springbootcrud.springbootcrudapi.service.TicketService;

@RestController
@RequestMapping("/api")
public class TicketController {
	
	@Autowired
	private TicketService ticketService;
	
	@GetMapping("/tickets")
	public List<Ticket> get() {
		return ticketService.get();
	}

	@PostMapping("/tickets")
	public Ticket save(@RequestBody Ticket ticketObj) {
		ticketService.save(ticketObj);
		return ticketObj;
	}
	
	@GetMapping("/tickets/{id}")
	public Ticket get(@PathVariable int id) {
		Ticket ticketObj = ticketService.get(id);
		if (ticketObj == null) {
			throw new RuntimeException("Ticket with id : "+ id + " is not found.."); 
		}
		return ticketObj;
	}
	
	@DeleteMapping("/tickets/{id}")
	public String delete(@PathVariable int id) {
		ticketService.delete(id);
		return "Ticket is deleted with id : " + id;
	}
	
	@PutMapping("/tickets")
	public Ticket update(@RequestBody Ticket ticketObj) {
		ticketService.save(ticketObj);
		return ticketObj;
	}
}

